---
import Layout from '../layouts/Layout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import SocialProof from '../components/SocialProof.astro';
---

<Layout title="Iwan Stepanova | SEO Expert - De Strategische Architect">
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center pt-28 md:pt-36 relative overflow-hidden">
    <!-- Grid Background -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(#00F5FF 1px, transparent 1px), linear-gradient(90deg, #00F5FF 1px, transparent 1px); background-size: 50px 50px;"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
        <div class="pt-8">
          <div class="reveal">
            <span class="font-mono text-cyan text-sm md:text-base uppercase tracking-wider block mb-4">
              // SEO Expert & Strategisch Architect
            </span>
            <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-tight">
              De <span class="text-cyan">Strategische</span> Architect voor Zoekmachine Dominantie.
            </h1>
          </div>
          
          <p class="font-body text-lg md:text-xl text-muted mt-6 max-w-xl reveal">
            Technical SEO, Content Architectuur & GEO voor de merken van morgen.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mt-8 reveal">
            <a 
              href="#diensten" 
              class="inline-block bg-cyan text-oxford font-heading font-bold text-lg px-8 py-4 hard-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all duration-300 text-center"
            >
              Ontdek Mijn Diensten
            </a>
            <a 
              href="#contact" 
              class="inline-block border-2 border-cyan text-cyan font-heading font-bold text-lg px-8 py-4 hover:bg-cyan hover:text-oxford transition-all duration-300 text-center"
            >
              Contact Opnemen
            </a>
          </div>

          <div class="mt-12 flex items-center gap-8 reveal">
            <div>
              <span class="font-heading text-4xl font-bold text-cyan">50+</span>
              <p class="font-mono text-xs text-muted mt-1">Projecten</p>
            </div>
            <div class="w-px h-12 bg-cyan/20"></div>
            <div>
              <span class="font-heading text-4xl font-bold text-cyan">100%</span>
              <p class="font-mono text-xs text-muted mt-1">Resultaat</p>
            </div>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="hidden lg:flex justify-center items-center reveal pt-16">
          <div class="relative">
            <div class="absolute inset-0 bg-cyan/10 hard-shadow-lg"></div>
            <div class="relative border-2 border-cyan/30 p-4">
              <div class="w-80 h-96 bg-oxford-light flex items-center justify-center border border-cyan/20">
                <div class="text-center">
                  <div class="font-heading text-6xl font-bold text-cyan/30">IS</div>
                  <p class="font-mono text-xs text-muted mt-2">Foto Iwan Stepanova</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <ServicesGrid />

  <!-- Social Proof -->
  <SocialProof />
</Layout>
