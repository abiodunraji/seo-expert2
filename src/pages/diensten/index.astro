---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const diensten = await getCollection('diensten');
---

<Layout title="Alle Diensten | Iwan Stepanova">
  <section class="pt-24 md:pt-32 pb-16 border-b-2 border-cyan/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="font-mono text-cyan text-sm uppercase tracking-wider">Diensten</span>
      <h1 class="font-heading text-4xl md:text-6xl font-bold mt-2 mb-12">
        Alle <span class="text-cyan">Diensten</span>
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-cyan/20 border-2 border-cyan/20">
        {diensten.sort((a, b) => a.data.order - b.data.order).map((dienst) => (
          <a 
            href={`/diensten/${dienst.id}/`}
            class="group bg-oxford p-8 hover:bg-oxford-light transition-colors duration-300"
          >
            <div class="text-3xl mb-4">{dienst.data.icon}</div>
            <h2 class="font-heading text-2xl font-bold mb-2 group-hover:text-cyan transition-colors">
              {dienst.data.title}
            </h2>
            <p class="font-mono text-sm text-muted">{dienst.data.shortDesc}</p>
            <div class="mt-4 font-mono text-cyan text-sm opacity-0 group-hover:opacity-100 transition-opacity">
              Lees meer →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
