---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((caseItem) => ({
    params: { slug: caseItem.id },
    props: { caseItem },
  }));
}

const { caseItem } = Astro.props;
const { Content } = await render(caseItem);

const allCases = await getCollection('cases');
const relatedCases = allCases.filter(c => c.id !== caseItem.id).slice(0, 2);
const base = import.meta.env.BASE_URL;
---

<Layout title={`${caseItem.data.title} | Iwan Stepanova`}>
  <!-- Hero -->
  <section class="pt-28 md:pt-36 pb-16 border-b-2 border-cyan/20 relative overflow-hidden">
    <!-- Grid Background -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(#00F5FF 1px, transparent 1px), linear-gradient(90deg, #00F5FF 1px, transparent 1px); background-size: 50px 50px;"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <a href={`${base}cases/`} class="font-mono text-cyan text-sm hover:underline mb-8 inline-block reveal">
        ← Terug naar cases
      </a>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
        <div>
          <div class="flex items-center gap-4 mb-6 reveal">
            <span class="font-mono text-xs text-cyan uppercase tracking-wider border border-cyan/30 px-3 py-1">{caseItem.data.industry}</span>
            <span class="font-mono text-xs text-muted">{caseItem.data.publishedDate.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long' })}</span>
          </div>
          
          <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight reveal">
            {caseItem.data.title}
          </h1>
          
          <div class="mt-6 flex items-center gap-4 reveal">
            <div class="w-12 h-12 bg-cyan/10 border-2 border-cyan/30 flex items-center justify-center">
              <span class="font-heading text-xl font-bold text-cyan">{caseItem.data.client.charAt(0)}</span>
            </div>
            <div>
              <p class="font-mono text-sm text-muted">Klant</p>
              <p class="font-heading text-lg font-bold">{caseItem.data.client}</p>
            </div>
          </div>
        </div>

        <!-- Case Image Placeholder -->
        <div class="reveal">
          <div class="border-2 border-cyan/30 p-2 hard-shadow-lg">
            <div class="bg-oxford-light aspect-video flex items-center justify-center border border-cyan/20">
              <div class="text-center">
                <div class="font-heading text-4xl font-bold text-cyan/20">CASE</div>
                <p class="font-mono text-xs text-muted mt-2">{caseItem.data.client}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Grid -->
  <section class="py-16 border-b-2 border-cyan/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 reveal">
        <span class="font-mono text-cyan text-sm uppercase tracking-wider">Resultaten</span>
        <h2 class="font-heading text-2xl md:text-3xl font-bold mt-2">De <span class="text-cyan">cijfers</span></h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-cyan/20 border-2 border-cyan/20">
        {caseItem.data.results.map((result, index) => (
          <div class="bg-oxford p-6 md:p-8 reveal" style={`transition-delay: ${index * 100}ms`}>
            <div class="font-heading text-2xl md:text-3xl font-bold text-cyan mb-2">{result}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Study Content -->
  <section class="py-16 border-b-2 border-cyan/20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="case-content prose prose-lg prose-invert max-w-none reveal">
        <Content />
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-16 border-b-2 border-cyan/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <span class="font-mono text-cyan text-sm uppercase tracking-wider">Aanpak</span>
        <h2 class="font-heading text-2xl md:text-3xl font-bold mt-2">Onze <span class="text-cyan">werkwijze</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="border-2 border-cyan/20 p-6 md:p-8 reveal">
          <div class="font-heading text-cyan text-4xl font-bold mb-4">01</div>
          <h3 class="font-heading text-xl font-bold mb-3">Analyse & Audit</h3>
          <p class="font-body text-muted">Grondige technische analyse van de huidige staat, concurrentieonderzoek en kansen identificatie.</p>
        </div>
        <div class="border-2 border-cyan/20 p-6 md:p-8 reveal">
          <div class="font-heading text-cyan text-4xl font-bold mb-4">02</div>
          <h3 class="font-heading text-xl font-bold mb-3">Strategie Ontwikkeling</h3>
          <p class="font-body text-muted">Op maat gemaakt SEO-plan met duidelijke mijlpalen, KPI's en verwachte resultaten.</p>
        </div>
        <div class="border-2 border-cyan/20 p-6 md:p-8 reveal">
          <div class="font-heading text-cyan text-4xl font-bold mb-4">03</div>
          <h3 class="font-heading text-xl font-bold mb-3">Implementatie</h3>
          <p class="font-body text-muted">Uitvoering van technische optimalisaties, content creatie en linkbuilding campagnes.</p>
        </div>
        <div class="border-2 border-cyan/20 p-6 md:p-8 reveal">
          <div class="font-heading text-cyan text-4xl font-bold mb-4">04</div>
          <h3 class="font-heading text-xl font-bold mb-3">Monitoring & Optimalisatie</h3>
          <p class="font-body text-muted">Continue monitoring van resultaten en bijsturing voor maximale performance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Cases -->
  {relatedCases.length > 0 && (
    <section class="py-16 border-b-2 border-cyan/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 reveal">
          <span class="font-mono text-cyan text-sm uppercase tracking-wider">Gerelateerd</span>
          <h2 class="font-heading text-2xl md:text-3xl font-bold mt-2">Meer <span class="text-cyan">cases</span></h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {relatedCases.map((related) => (
            <a 
              href={`${base}cases/${related.id}/`}
              class="group border-2 border-cyan/20 hover:border-cyan/50 transition-colors duration-300 block reveal"
            >
              <div class="p-6 md:p-8">
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs text-muted uppercase">{related.data.industry}</span>
                  <span class="font-mono text-xs text-cyan">{related.data.client}</span>
                </div>
                <h3 class="font-heading text-xl font-bold mb-4 group-hover:text-cyan transition-colors">
                  {related.data.title}
                </h3>
                <ul class="space-y-2">
                  {related.data.results.slice(0, 2).map((result) => (
                    <li class="font-mono text-sm text-cyan">✓ {result}</li>
                  ))}
                </ul>
                <div class="mt-4 font-mono text-sm text-muted group-hover:text-offwhite transition-colors">
                  Bekijk case →
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold mb-6 reveal">
        Jouw <span class="text-cyan">succesverhaal</span>?
      </h2>
      <p class="font-mono text-muted text-lg mb-8 reveal">
        Laten we samen werken aan jouw groei.
      </p>
      <a 
        href={`${base}#contact`} 
        class="inline-block bg-cyan text-oxford font-heading font-bold text-lg px-8 py-4 hard-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all duration-300 reveal"
      >
        Start Jouw Groei →
      </a>
    </div>
  </section>
</Layout>
