---
const logos = [
  { name: 'Bedrijf A', placeholder: true },
  { name: 'Bedrijf B', placeholder: true },
  { name: 'Bedrijf C', placeholder: true },
  { name: 'Bedrijf D', placeholder: true },
  { name: 'Bedrijf E', placeholder: true },
  { name: 'Bedrijf F', placeholder: true },
];
---

<section class="py-16 md:py-24 border-b-2 border-cyan/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12 reveal">
      <span class="font-mono text-cyan text-sm uppercase tracking-wider">Social Proof</span>
      <h2 class="font-heading text-3xl md:text-4xl font-bold mt-2">
        Vertrouwd door <span class="text-cyan">marktleiders</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 reveal">
      {logos.map((logo) => (
        <div class="border-2 border-cyan/20 p-6 flex items-center justify-center hover:border-cyan/50 transition-colors duration-300">
          <span class="font-mono text-muted text-sm text-center">
            {logo.name}
          </span>
        </div>
      ))}
    </div>

    <p class="font-mono text-xs text-muted mt-6 text-center">
      * Plaats hier de logo's van eerdere klanten
    </p>
  </div>
</section>
