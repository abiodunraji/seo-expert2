---
const ctaText = "Laten we praten over jouw groei";
---

<footer class="border-t-2 border-cyan/20">
  <!-- CTA Section -->
  <section id="contact" class="py-16 md:py-24 border-b-2 border-cyan/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-4xl md:text-6xl lg:text-7xl font-bold mb-6 reveal">
        Klaar voor <span class="text-cyan">dominantie</span>?
      </h2>
      <p class="font-mono text-muted text-lg md:text-xl mb-8 max-w-2xl mx-auto reveal">
        {ctaText}.
      </p>
      <a 
        href="mailto:hello@iwanstepanova.nl" 
        class="inline-block bg-cyan text-oxford font-heading font-bold text-lg md:text-xl px-8 py-4 hard-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all duration-300 reveal"
      >
        Neem Contact Op →
      </a>
    </div>
  </section>

  <!-- Marquee -->
  <div class="overflow-hidden border-b-2 border-cyan/20 py-6 bg-oxford-light">
    <div class="marquee whitespace-nowrap">
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        IWAN STEPANOVA
      </span>
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        SEO EXPERT
      </span>
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        STRATEGISCH ARCHITECT
      </span>
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        IWAN STEPANOVA
      </span>
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        SEO EXPERT
      </span>
      <span class="font-heading text-6xl md:text-8xl font-bold text-cyan/10 mx-8">
        STRATEGISCH ARCHITECT
      </span>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="font-heading text-4xl font-bold tracking-tighter">
        IS<span class="text-cyan">.</span>
      </div>
      <p class="font-mono text-sm text-muted">
        © {new Date().getFullYear()} Iwan Stepanova. Alle rechten voorbehouden.
      </p>
      <ul class="flex gap-6">
        <li>
          <a href="#" class="font-mono text-sm text-muted hover:text-cyan transition-colors">LinkedIn</a>
        </li>
        <li>
          <a href="#" class="font-mono text-sm text-muted hover:text-cyan transition-colors">Twitter/X</a>
        </li>
      </ul>
    </div>
  </div>
</footer>
