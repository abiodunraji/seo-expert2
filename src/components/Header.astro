---
const base = import.meta.env.BASE_URL;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Diensten', href: '/#diensten' },
  { label: 'Cases', href: '/cases/' },
  { label: 'Contact', href: '/#contact' },
];

function link(href) {
  if (href.startsWith('/#')) {
    return base + href.slice(1);
  }
  if (href.startsWith('/')) {
    return base + href;
  }
  return href;
}

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 w-full z-50 bg-oxford/95 backdrop-blur-sm border-b-2 border-cyan/20">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Hoofdnavigatie">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href={link('/')} class="text-2xl md:text-3xl font-heading font-bold tracking-tighter hover:text-cyan transition-colors duration-300">
        IS<span class="text-cyan">.</span>
      </a>
      
      <!-- Desktop Nav -->
      <ul class="hidden md:flex items-center gap-8">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === base || currentPath === base + 'index.html'
            : currentPath.startsWith(base + item.href.replace('/#', '').replace('/', ''));
          return (
            <li>
              <a 
                href={link(item.href)} 
                class={`font-mono text-sm uppercase tracking-wider transition-colors duration-300 relative group ${
                  isActive 
                    ? 'text-cyan' 
                    : 'text-offwhite hover:text-cyan'
                }`}
              >
                {item.label}
                <span class={`absolute -bottom-1 left-0 h-0.5 bg-cyan transition-all duration-300 ${
                  isActive ? 'w-full' : 'w-0 group-hover:w-full'
                }`}></span>
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden text-offwhite hover:text-cyan transition-colors p-2 border border-cyan/30"
        aria-label="Menu openen"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-cyan/20 py-4">
      <ul class="flex flex-col gap-4">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === base || currentPath === base + 'index.html'
            : currentPath.startsWith(base + item.href.replace('/#', '').replace('/', ''));
          return (
            <li>
              <a 
                href={link(item.href)} 
                class={`font-mono text-sm uppercase tracking-wider transition-colors duration-300 block py-2 ${
                  isActive ? 'text-cyan' : 'text-offwhite hover:text-cyan'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
